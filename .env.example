# Discord application (https://discord.com/developers/applications -> OAuth2).
# Add "<APP_URL>/api/auth/callback" as a redirect URI on the application.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Public URL of the site, no trailing slash.
APP_URL=http://localhost:3000

# Long random string used to sign login cookies: openssl rand -hex 32
SESSION_SECRET=

# Comma-separated Discord user IDs that can open /admin.
ADMIN_DISCORD_IDS=

# SQLite file (default) or a hosted libSQL/Turso database.
# DATABASE_URL=file:./data/ninethree.db
# DATABASE_URL=libsql://your-db.turso.io
# DATABASE_AUTH_TOKEN=

# Local development only: lets you sign in without Discord via
# /api/auth/dev?as=alice (user id "dev-alice"). Ignored in production.
# DEV_LOGIN=1
